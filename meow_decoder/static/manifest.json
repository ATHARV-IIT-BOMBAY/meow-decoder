{
  "name": "Meow Decoder",
  "short_name": "Meow",
  "description": "Guess what a cat's meow is about, with honest percentages.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F7D9DC",
  "theme_color": "#F7D9DC",
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "/api/predict",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [
        { "name": "audio", "accept": ["audio/*", "video/*"] }
      ]
    }
  }
}
